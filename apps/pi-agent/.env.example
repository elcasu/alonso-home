CLOUD_URL=http://localhost:4074
DEVICE_TOKEN=genera-un-token-largo-para-la-pi
GPIO_MOCK=1
# 1 = relé active-low. 0 = LED GPIO→resistencia→GND (banco).
GPIO_ACTIVE_LOW=1
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=alonso
MQTT_PASSWORD=alonso
MQTT_ENABLED=0
# --- Home Assistant (MQTT Discovery) ---
# 1 = anuncia las zonas GPIO como switches de HA y acepta comandos desde HA.
HA_ENABLED=0
# Broker que lee Home Assistant. Si se omiten, se usan MQTT_URL / MQTT_USER / MQTT_PASSWORD.
# HA_MQTT_URL=mqtt://192.168.100.5:1883
# HA_MQTT_USER=alonso
# HA_MQTT_PASSWORD=la-clave-de-deploy/homeassistant/.env
# Nombre del nodo en los topics (alonso/<nodo>/...) y del dispositivo en HA.
# HA_NODE_ID=alonso_pi
# HA_DEVICE_NAME=Alonso Pi
# 1 solo si los ESP32 tienen el firmware viejo (home/<id>/set) y querés que la Pi los anuncie.
# HA_EXPOSE_ESP32=0

TZ=America/Argentina/Buenos_Aires
LOCAL_API_PORT=3001
DATA_DIR=./data

# --- Cámaras (opcional; sin CAMERAS el módulo queda apagado) ---
# JSON: lista de cámaras Xiongmai/iCSee en la LAN.
# CAMERAS=[{"id":"entrada","host":"192.168.100.206","user":"admin","password":""}]
# auto = iot si hay IOT_ENDPOINT, si no http (CLOUD_URL+DEVICE_TOKEN), si no log
CAMERA_SINK=auto
# AWS IoT Core: endpoint ATS de la cuenta (aws iot describe-endpoint --endpoint-type iot:Data-ATS)
# IOT_ENDPOINT=xxxxxxxx-ats.iot.us-east-1.amazonaws.com
IOT_CLIENT_ID=alonso-pi
# Debe contener device.pem.crt, private.pem.key y AmazonRootCA1.pem (generados por deploy/aws-iot/setup.sh)
IOT_CERTS_DIR=./certs
CAMERA_START_COOLDOWN_MS=20000
CAMERA_STATUS_INTERVAL_MS=30000
CAMERA_OUTBOX_MAX_AGE_MS=21600000
CAMERA_OUTBOX_MAX_ROWS=300
