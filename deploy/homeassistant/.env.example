# up.sh crea .env desde este archivo y genera las contraseñas MQTT. No commitees .env.
TZ=America/Argentina/Buenos_Aires
HA_PORT=8124
MQTT_PORT=1883

# Usuarios del broker. up.sh los genera si están vacíos.
# ha: lo usa Home Assistant. alonso: lo usan el pi-agent y los ESP32.
MQTT_HA_USER=ha
MQTT_HA_PASSWORD=
MQTT_DEVICE_USER=alonso
MQTT_DEVICE_PASSWORD=
