# Copiá a .env y completá. No commitees .env.

# Cámara de laboratorio (patrón de prueba, sin hardware)
FRIGATE_LAB=1

# Usuario/clave ONVIF-RTSP de las GT-N3 (el de iCSee, no la cuenta de la app)
FRIGATE_RTSP_USER=admin
FRIGATE_RTSP_PASSWORD=cambiame

# IPs locales. Dejá vacío lo que no esté en la red.
FRIGATE_CAM1_HOST=
FRIGATE_CAM1_NAME=entrada
FRIGATE_CAM2_HOST=
FRIGATE_CAM2_NAME=patio
FRIGATE_CAM3_HOST=
FRIGATE_CAM3_NAME=cochera

# S3. Sin credenciales AWS el uploader escribe en data/s3-dry/ (modo ensayo).
AWS_REGION=us-east-2
S3_BUCKET=alonso-home-nvr
S3_PREFIX=events
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=personal

TZ=America/Argentina/Buenos_Aires
FRIGATE_UI_PORT=8971
